<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="@color/white_20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <com.knvbepr.panelink.ui.DsegTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="04"
            android:textColor="@color/white_60"
            android:textSize="12sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <com.knvbepr.panelink.ui.MonoTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="TABLE"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.knvbepr.panelink.ui.MonoTextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2DP HEAD / 1DP ROWS" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white_50" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="10dp"
        android:paddingBottom="8dp">

        <com.knvbepr.panelink.ui.MonoTextView
            style="@style/Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:text="SYSTEM" />

        <com.knvbepr.panelink.ui.MonoTextView
            style="@style/Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:gravity="end"
            android:text="READING" />

        <com.knvbepr.panelink.ui.MonoTextView
            style="@style/Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.55"
            android:paddingStart="10dp"
            android:text="UNIT" />

        <com.knvbepr.panelink.ui.MonoTextView
            style="@style/Text.Label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.25"
            android:gravity="end"
            android:text="STATE" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="@color/white" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <com.knvbepr.panelink.ui.MonoTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:text="ENG 1"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <com.knvbepr.panelink.ui.DsegTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:gravity="end"
            android:text="082"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <com.knvbepr.panelink.ui.MonoTextView
            style="@style/Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.55"
            android:paddingStart="10dp"
            android:text="%" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
        android:baselineAligned="false">

            <com.knvbepr.panelink.ui.MonoTextView
                style="@style/Widget.Panel.Badge.Outline.Green"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="PASS"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white_20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <com.knvbepr.panelink.ui.MonoTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:text="APU"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <com.knvbepr.panelink.ui.DsegTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:gravity="end"
            android:text="000"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <com.knvbepr.panelink.ui.MonoTextView
            style="@style/Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.55"
            android:paddingStart="10dp"
            android:text="%" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
        android:baselineAligned="false">

            <com.knvbepr.panelink.ui.MonoTextView
                style="@style/Widget.Panel.Badge.Outline.Muted"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="STBY"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white_20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <com.knvbepr.panelink.ui.MonoTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:text="HYD 1"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <com.knvbepr.panelink.ui.DsegTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:gravity="end"
            android:text="174"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <com.knvbepr.panelink.ui.MonoTextView
            style="@style/Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.55"
            android:paddingStart="10dp"
            android:text="BAR" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
        android:baselineAligned="false">

            <com.knvbepr.panelink.ui.MonoTextView
                style="@style/Widget.Panel.Badge.Solid.Amber"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="CAUTION"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white_20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <com.knvbepr.panelink.ui.MonoTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.15"
            android:text="FUEL 2"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <com.knvbepr.panelink.ui.DsegTextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.0"
            android:gravity="end"
            android:text="04260"
            android:textColor="@color/white"
            android:textSize="17sp" />

        <com.knvbepr.panelink.ui.MonoTextView
            style="@style/Text.Caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.55"
            android:paddingStart="10dp"
            android:text="KG" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.25"
            android:gravity="end|center_vertical"
            android:orientation="horizontal"
        android:baselineAligned="false">

            <com.knvbepr.panelink.ui.MonoTextView
                style="@style/Widget.Panel.Badge"
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="NORM"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white_20" />

    <com.knvbepr.panelink.ui.MonoTextView
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ROW VALUES SET IN DSEG7 / STATE IS ALWAYS SPELLED OUT" />

</LinearLayout>

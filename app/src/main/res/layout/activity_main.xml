<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp">

        <!-- Masthead -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
        android:baselineAligned="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <com.knvbepr.panelink.ui.MonoTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.2"
                android:text="PANEL"
                android:textColor="@color/white"
                android:textSize="22sp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.knvbepr.panelink.ui.MonoTextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HMI SPECIMEN / 001" />

            <com.knvbepr.panelink.ui.MonoTextView
                android:id="@+id/lang_toggle"
                style="@style/Widget.Panel.Badge"
                android:layout_width="52dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_button_secondary"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:stateListAnimator="@null"
                android:text="中文"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
        android:baselineAligned="false"
            android:paddingBottom="12dp">

            <com.knvbepr.panelink.ui.MonoTextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AERONAUTICAL INSTRUMENTATION" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <com.knvbepr.panelink.ui.MonoTextView
                style="@style/Text.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API 21+ / JAVA" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/white_50" />

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/section_01_buttons" />

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/section_02_badges" />

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/section_03_telemetry" />

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/section_04_table" />

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/section_05_inputs" />

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/section_06_alarms" />

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/section_07_charts" />

        <include
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            layout="@layout/section_tokens" />

    </LinearLayout>
</ScrollView>

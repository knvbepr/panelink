<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="24dp"
        android:background="@color/white_20" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:baselineAligned="false"
        android:paddingTop="12dp"
        android:paddingBottom="10dp">

        <com.example.panel.ui.DsegTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="06"
            android:textColor="@color/white_60"
            android:textSize="12sp" />

        <View
            android:layout_width="10dp"
            android:layout_height="1dp" />

        <com.example.panel.ui.MonoTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.12"
            android:text="ALARM BANNERS"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.example.panel.ui.MonoTextView
            style="@style/Text.Caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BLINK / CONTINUOUS" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/white_50" />

    <com.example.panel.ui.MonoTextView
        android:id="@+id/banner_warning"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_solid_red"
        android:gravity="center_vertical"
        android:letterSpacing="0.08"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="WARNING // BLEED AIR LEAK — ENG 2"
        android:textColor="@color/ink"
        android:textSize="11sp" />

    <com.example.panel.ui.MonoTextView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_solid_amber"
        android:gravity="center_vertical"
        android:letterSpacing="0.08"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="CAUTION // FUEL IMBALANCE — TRIM 1.4"
        android:textColor="@color/ink"
        android:textSize="11sp" />

    <com.example.panel.ui.MonoTextView
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_outline_white_50"
        android:gravity="center_vertical"
        android:letterSpacing="0.08"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="INFO // DATA LINK DEGRADED"
        android:textColor="@color/white"
        android:textSize="11sp" />

    <com.example.panel.ui.MonoTextView
        style="@style/Text.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="ONLY FAULT CLASS BLINKS: 0.5S STEP / CONTINUOUS / BLACK TEXT ON STATUS FILL" />

</LinearLayout>
